{
  "name": "@xboards-kancelaria-obrotu-nieruchomosciami/react",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "React hooks of the real estate office's rooms, generated by xmeta codegen: one module per kind under the path of its catalog's position in spec/ (e.g. @xboards-kancelaria-obrotu-nieruchomosciami/react/positions/stanowisko/stanowisko-ustalenia)",
  "exports": {
    "./*": "./src/*.gen.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write package.json tsconfig.json",
    "format:check": "prettier --check package.json tsconfig.json"
  },
  "ciRepositories": [
    "mirrorboards-core/mirrorboards-xmeta/xmeta-cli"
  ],
  "dependencies": {
    "@mirrorboards-xmeta/react": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@mirrorboards-dev/formatter-typescript": "workspace:*",
    "@mirrorboards-utils/workspace-source": "workspace:*",
    "@types/node": "^25.9.5",
    "@types/react": "^19.3.0",
    "prettier": "3.9.5",
    "react": "19.2.7",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "prettier": "@mirrorboards-dev/formatter-typescript"
}
